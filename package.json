{
  "name": "saiu-chess-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/server.ts",
    "schema": "SCC_SCHEMA_OUT=./schema.jsonl vitest run && node scripts/gen-schema.mjs ./schema.jsonl",
    "bundle": "node scripts/bundle.mjs",
    "deploy:dry": "npm run typecheck && npm run test && npm run bundle"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
